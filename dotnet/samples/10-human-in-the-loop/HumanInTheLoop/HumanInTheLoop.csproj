<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Foundry hosted agents run on the dotnet_10 runtime -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MafSamples.HumanInTheLoop</RootNamespace>
    <!-- Code deploy uploads only this folder, so Directory.Packages.props is not available -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <UserSecretsId>f16d79ed-e20b-4c4f-a972-fd26ac7793d5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.24.0-preview.261006.1" />
  </ItemGroup>

</Project>
