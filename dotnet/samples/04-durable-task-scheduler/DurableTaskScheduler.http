@host = http://localhost:7099
@agent = weekend-planner

### Start a new conversation (note the x-ms-session-id response header)
POST {{host}}/api/agents/{{agent}}/run
Content-Type: application/json

{
  "message": "What should I do this weekend in Auckland?"
}

### Continue the same session — paste the x-ms-session-id value below
# @name continueSession
POST {{host}}/api/agents/{{agent}}/run?sessionId=945d4230-97cc-4342-8e71-449c48e07a65
Content-Type: application/json

{
  "message": "What is the weather like there?"
}
